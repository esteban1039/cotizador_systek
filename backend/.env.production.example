# Plantilla de PRODUCCIÓN (Laravel Forge). Copia estos valores al entorno del sitio en Forge; nunca subas el archivo real a Git.
# Los valores marcados <...> los defines tú. Ver docs/despliegue.md.

APP_NAME="Systek Cotizador"
APP_ENV=production
# Genera con `php artisan key:generate --show` UNA vez. RESPÁLDALA fuera del servidor (gestor de secretos + copia física):
# cifra la cuenta bancaria, los PDF oficiales archivados y los secretos de MFA; sin ella esos datos son irrecuperables.
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.<tu-dominio>

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL de Forge. Usa un usuario de aplicación (no el superusuario).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<base>
DB_USERNAME=<usuario_app>
DB_PASSWORD=<contraseña>
# Zona horaria de la conexión: debe coincidir con app.timezone (America/Bogota).
DB_TIMEZONE=America/Bogota

# Una sola máquina: archivo es suficiente. Con varias réplicas usa CACHE_STORE=database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# La API solo debe atender al proxy BFF (Cloudflare). Genera un valor largo y aleatorio (p. ej. `openssl rand -hex 32`)
# y configura el MISMO valor como NUXT_BFF_SECRET en Cloudflare. Sin este valor la API responde 503 en producción.
BFF_SHARED_SECRET=

# MFA obligatorio para roles privilegiados. Actívalo solo cuando cada admin/aprobador ya tenga su autenticador
# configurado y sus códigos de recuperación guardados (no existe recuperación por correo).
MFA_REQUIRED_ROLES=admin,approver

DRIVE_INVENTORY_ENABLED=false

# Asistente IA: desactivado hasta decidir. La clave solo aquí.
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-haiku-4-5-20251001
AI_ASSISTANT_TIMEOUT=12
AI_ASSISTANT_CONNECT_TIMEOUT=3
AI_ASSISTANT_MAX_OUTPUT_TOKENS=2048
AI_ASSISTANT_MAX_CATALOG_ITEMS=400
AI_ASSISTANT_MAX_DESCRIPTION_CHARS=120
AI_ASSISTANT_MAX_INPUT_CHARS=4000
AI_ASSISTANT_PER_MINUTE=5
AI_ASSISTANT_PER_DAY=30
