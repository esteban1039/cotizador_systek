APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recuperación de contraseña: URL pública del frontend (base del enlace del correo).
FRONTEND_URL=http://localhost:3003

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF oficiales: `database` (local) o `s3` (usa AWS_* y el bucket privado AWS_BUCKET).
QUOTE_PDF_STORAGE=database

VITE_APP_NAME="${APP_NAME}"

# Comma-separated privileged roles: admin,approver. Empty keeps MFA optional.
MFA_REQUIRED_ROLES=

# Read-only metadata inventory. Token file must be private, mode 0600.
DRIVE_INVENTORY_ENABLED=false
DRIVE_ROOT_FOLDER_ID=
DRIVE_ACCESS_TOKEN_FILE=

# Asistente IA (borrador desde texto libre). Desactivado por defecto; la clave solo aquí, nunca en el repositorio.
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-haiku-4-5-20251001
AI_ASSISTANT_TIMEOUT=12
AI_ASSISTANT_CONNECT_TIMEOUT=3
AI_ASSISTANT_MAX_OUTPUT_TOKENS=2048
AI_ASSISTANT_MAX_CATALOG_ITEMS=400
AI_ASSISTANT_MAX_DESCRIPTION_CHARS=120
AI_ASSISTANT_MAX_INPUT_CHARS=4000
AI_ASSISTANT_PER_MINUTE=5
AI_ASSISTANT_PER_DAY=30
# Base de conocimiento (precedentes sin dinero ni datos de cliente). Apagada por defecto.
AI_KNOWLEDGE_ENABLED=false
AI_KNOWLEDGE_TOP_K=4
AI_KNOWLEDGE_MIN_SCORE=0.15
AI_KNOWLEDGE_MAX_PRECEDENT_CHARS=1200
AI_KNOWLEDGE_AUTO_ACTIVATE=true
AI_KNOWLEDGE_MAX_AI_ASSISTED=2

# Solo producción: secreto compartido con el proxy BFF (mismo valor en NUXT_BFF_SECRET). Ver .env.production.example.
BFF_SHARED_SECRET=
